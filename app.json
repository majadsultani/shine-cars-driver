{
  "expo": {
    "name": "Shine Cars Driver",
    "slug": "shine-cars-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "privacy": "https://shine-cars-website.vercel.app/privacy",
    "scheme": "shinecarsdriver",
    "sdkVersion": "57.0.0",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1629"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shinecars.driver",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shine Cars Driver needs your location so dispatchers can find and assign you nearby bookings.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#0F1629",
      "barStyle": "light-content"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1629",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.shinecars.driver",
      "softwareKeyboardLayoutMode": "adjustPan",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/booking_alert.wav"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shine Cars Driver needs your location so dispatchers can find and assign you nearby bookings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shine Cars Driver to access your photos to upload documents.",
          "cameraPermission": "Allow Shine Cars Driver to use your camera to capture documents."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "209de5f2-6075-4ce8-a799-d2a6ac247e30"
      }
    },
    "owner": "shinecars"
  }
}
